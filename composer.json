{
    "name": "moffhub/sms-handler",
    "description": "A simple SMS integration helper for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "moffhub",
        "sms",
        "laravel",
        "helper",
        "integration",
        "twilio",
        "nexmo",
        "africastalking",
        "sms gateway",
        "sms handler",
        "advanta",
        "onfon"
    ],
    "authors": [
        {
            "name": "Moffat Munene",
            "email": "moffmu@gmail.com"
        }
    ],
    "contributors": [
        {
            "name": "Moffat Munene",
            "email": "moffmu@gmail.com",
            "homepage": "https://github.com/MOFFROUGH",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^10.1"
    },
    "autoload": {
        "psr-4": {
            "Moffhub\\SmsHandler\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Moffhub\\SmsHandler\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moffhub\\SmsHandler\\SmsHandlerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "check-code": [
            "@lint",
            "@phpstan",
            "@test"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "lint:fix": [
            "vendor/bin/pint"
        ],
        "phpstan": [
            "vendor/bin/phpstan"
        ],
        "test": [
            "vendor/bin/phpunit"
        ]
    }
}
