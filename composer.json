{
    "name": "moffhub/sms-handler",
    "description": "Unified SMS gateway for Laravel with multi-provider support (Advanta, Africa's Talking, Twilio, Nexmo, Onfon). Queue-ready, delivery tracking, fallback chains, templating, and analytics.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sms",
        "sms-gateway",
        "twilio",
        "nexmo",
        "vonage",
        "africastalking",
        "advanta",
        "onfon",
        "bulk-sms",
        "sms-notification",
        "laravel-package",
        "sms-provider",
        "delivery-report",
        "sms-template",
        "africa"
    ],
    "homepage": "https://github.com/moffhub/sms-handler",
    "support": {
        "issues": "https://github.com/moffhub/sms-handler/issues",
        "source": "https://github.com/moffhub/sms-handler"
    },
    "authors": [
        {
            "name": "Moffat Munene",
            "email": "moffmu@gmail.com"
        }
    ],
    "contributors": [
        {
            "name": "Moffat Munene",
            "email": "moffmu@gmail.com",
            "homepage": "https://github.com/MOFFROUGH",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^10.1",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Moffhub\\SmsHandler\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Moffhub\\SmsHandler\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moffhub\\SmsHandler\\SmsHandlerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "check-code": [
            "@lint",
            "@phpstan",
            "@test"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "lint:fix": [
            "vendor/bin/pint"
        ],
        "phpstan": [
            "vendor/bin/phpstan"
        ],
        "test": [
            "vendor/bin/phpunit"
        ]
    }
}
